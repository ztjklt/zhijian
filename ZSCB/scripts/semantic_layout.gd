extends RefCounted

# Complete editorial units, independent of their rendering. Lines are deliberate
# reading lines; a poem is never sampled, tiled or wrapped into terrain fragments.
static func chapters() -> Array:
	return [
		{"title":"数与形","foundation":["数与形相互联系：用数表示数量，用形描述空间；从等式的运算走向几何的证明，在条件与结论之间建立清楚的联系。","等式两边同时加上或减去同一个数，等式仍然成立。运算时应保持每一步的依据。","直角三角形的两条直角边为 a、b，斜边为 c。勾股定理只适用于直角三角形。"],"summary":["从已知条件出发，写清推导的每一步。","公式中的字母必须对应图中的量。","数与形结合，让计算与证明互相检验。"]},
		{"title":"字里山河","foundation":["桃花源记（连续节选）　陶渊明：晋太元中，武陵人捕鱼为业。缘溪行，忘路之远近。忽逢桃花林，夹岸数百步，","中无杂树，芳草鲜美，落英缤纷。渔人甚异之，复前行，欲穷其林。","林尽水源，便得一山，山有小口，仿佛若有光。便舍船，从口入。","初极狭，才通人。复行数十步，豁然开朗。土地平旷，屋舍俨然，有良田、美池、桑竹之属。"],"summary":["整首阅读，观察意象怎样连接情感。","《秋思》以景物铺陈游子的羁旅之愁。","《春望》由眼前春景写到忧国与思家。"]},
		{"title":"时间长廊","foundation":["历史的线索来自文物与文献：甲骨文刻在龟甲和兽骨上，金文多见于青铜器。把不同史料相互参照，才能理解过去。","秦汉时期，统一的多民族国家得到建立和发展。丝绸之路促进不同地区的交流。","隋唐以后，城市、商业与文化继续发展。朝代示意只标顺序，不代表等距的年代。"],"summary":["先辨认史料，再观察它能够说明什么。","年代顺序与实际时间长度应加以区别。","文献和实物相互参照，认识历史的变化。"]},
		{"title":"光与力","foundation":["物理研究从观察与测量开始：力可以改变物体的运动状态，也可以改变物体的形状。联系图示、物理量和公式，解释现象。","合力 F 与质量 m、加速度 a 的关系为 F = ma。速度的变化与受力方向有关。","光在同种均匀介质中沿直线传播。反射角与入射角都从法线量起，二者相等。"],"summary":["画图确定研究对象，标明力与运动方向。","代入公式前，先统一各个物理量的单位。","区分光的反射与折射，角度从法线量起。"]},
		{"title":"元素之间","foundation":["化学从宏观现象走向微观解释：物质由分子、原子或离子等微观粒子构成。化学变化中原子重新组合，生成新的物质。","元素是具有相同核电荷数的一类原子的总称。化学式表示物质的组成。","反应前后，原子的种类、数目和质量保持不变。化学方程式必须先配平。"],"summary":["观察现象，提出问题，再寻找微观解释。","化学式说明组成，结构式表示连接方式。","配平反应式，检查每种原子的数量守恒。"]},
		{"title":"函数远方","foundation":["函数描述两个变量之间的对应关系：自变量改变，函数值随之变化。把对应的坐标点画在同一平面上，就得到函数图像。","一次函数的图像是一条直线，二次函数的图像是抛物线。系数影响位置和形状。","正弦函数具有周期性。一个周期内的变化会重复，周期表示重复一次所需的间隔。"],"summary":["先读坐标轴，再看函数的取值与变化。","一次函数、二次函数与周期函数各有形状。","图像上的每一个点，都对应一组变量值。"]}
	]

static func poems() -> Array:
	return [
		{"id":"autumn","title":"天净沙·秋思","author":"马致远","lines":["枯藤老树昏鸦，","小桥流水人家，","古道西风瘦马。","夕阳西下，","断肠人在天涯。"]},
		{"id":"spring","title":"春望","author":"杜甫","lines":["国破山河在，城春草木深。","感时花溅泪，恨别鸟惊心。","烽火连三月，家书抵万金。","白头搔更短，浑欲不胜簪。"]}
	]
